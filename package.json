  "name": "employee-monitoring-workspace",
  "private": true,
  "workspaces": [
    "employee-monitoirng-backend",
    "employee-monitoring-frontend"
  ],
  "scripts": {
    "start": "npm --prefix employee-monitoirng-backend start",
